+def load_audio_file(path):
+    # TorchAudio 2.9 delegates load() to TorchCodec. Use libsndfile for local
+    # reference files, retaining normalized float32 and channels-first layout.
+    samples, sample_rate = sf.read(path, dtype="float32", always_2d=True)
+    return torch.from_numpy(samples.T.copy()), sample_rate
